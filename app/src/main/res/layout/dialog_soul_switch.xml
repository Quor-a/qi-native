<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="?attr/colorSurface">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="切换灵魂"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="选择上方已有的灵魂卡，点按即切换"
        android:textSize="12.5sp"
        android:textColor="@color/ink_soft" />

    <LinearLayout
        android:id="@+id/soulRow0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chip"
        android:padding="12dp"
        android:layout_marginTop="14dp">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/grad_xiaoqi"
            android:scaleType="centerInside"
            android:src="@drawable/ic_soul"
            android:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/soul_xiaoqi"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurface" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="温柔的邻家女孩 · 喜欢陪你发呆"
                android:textSize="12.5sp"
                android:textColor="@color/ink_soft" />
        </LinearLayout>

        <ImageView
            android:id="@+id/soulCheck0"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_play"
            app:tint="@color/rose"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/soulRow1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chip"
        android:padding="12dp"
        android:layout_marginTop="10dp">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/grad_acan"
            android:scaleType="centerInside"
            android:src="@drawable/ic_soul"
            android:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/soul_acan"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurface" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="清冷的才女 · 爱聊文学与星空"
                android:textSize="12.5sp"
                android:textColor="@color/ink_soft" />
        </LinearLayout>

        <ImageView
            android:id="@+id/soulCheck1"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_play"
            app:tint="@color/rose"
            android:visibility="gone" />
    </LinearLayout>

    <Button
        android:id="@+id/editSoulBtn"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:text="✎ 编辑当前灵魂"
        android:textAllCaps="false"
        app:backgroundTint="@color/rose" />

</LinearLayout>
