<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="start"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <!-- AI 头像（左侧，仅 AI 消息显示） -->
    <ImageView
        android:id="@+id/mini"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/grad_xiaoqi"
        android:scaleType="centerInside"
        android:src="@drawable/ic_soul" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 自己的名字（仅自己发的消息显示） -->
        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginBottom="2dp"
            android:textSize="12sp"
            android:textColor="@color/ink_soft"
            android:visibility="gone" />

        <TextView
            android:id="@+id/bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="250dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textSize="14.5sp"
            android:lineSpacingExtra="2dp"
            android:textColor="#3A2E33"
            android:background="@drawable/bg_bubble_them" />

        <ImageView
            android:id="@+id/imgAttach"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="6dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_input"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 自己的头像（右侧，仅自己发的消息显示，点击打开用户资料卡） -->
    <ImageView
        android:id="@+id/miniMe"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:background="@color/ink_faint"
        android:scaleType="centerInside"
        android:src="@drawable/ic_user"
        android:visibility="gone" />
</LinearLayout>
